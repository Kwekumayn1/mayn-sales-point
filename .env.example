# Supabase — from Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key — NEVER prefix with NEXT_PUBLIC_, never expose to the browser.
# Used later (Phase 5+) for admin wallet/ledger operations that must run server-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of emails that get Super Admin on signup (Phase 1 admin bootstrap)
ADMIN_EMAILS=youremail@example.com

# Added in later phases — placeholders only, do not fill in yet
# PAYMENT_PROVIDER=paystack
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
